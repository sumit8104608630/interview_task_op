# ==============================================================================
# Hotel Booking Portal - Environment Configuration Template
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking_portal
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Customer Authentication & JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=hotel-booking-portal
JWT_AUDIENCE=hotel-booking-portal-customer
CUSTOMER_SESSION_TTL=7d
AUTH_COOKIE_NAME=auth_token
CSRF_COOKIE_NAME=csrf_token

# External OTP & Notification Microservice (Deployed API)
OTP_SERVICE_BASE_URL=https://otp-microservise.vercel.app
OTP_SERVICE_API_KEY=
OTP_SERVICE_TIMEOUT_MS=10000

# Cloudinary Image Storage (for hotel catalog)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend Client Origin (for CORS allowlist)
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
