# ==============================================================================
# Hotel Booking Portal - Environment Configuration Template
# Copy this file to .env for local development. Never commit real credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
# Use DATABASE_URL for a full connection string, or set individual params below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_booking_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# External OTP & Notification Microservice
NOTIFICATION_SERVICE_BASE_URL=http://localhost:4000/api/v1
NOTIFICATION_SERVICE_API_KEY=your_microservice_api_key

# Frontend Client Origin (for CORS)
FRONTEND_URL=http://localhost:5173
