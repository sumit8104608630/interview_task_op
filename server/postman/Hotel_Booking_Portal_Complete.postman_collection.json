{
  "info": {
    "name": "Hotel Booking Portal - Complete Enterprise API Collection",
    "_postman_id": "f83a912e-9d21-4d1a-82bc-9289d042f88b",
    "description": "Production-grade, unified Postman collection covering all phases: Authentication, Catalogue, Locations, Room Types, Search, Availability, Booking Creation, Customer History, and Secure Cancellation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "sampleHotelId", "value": "grand-residency-mumbai-001", "type": "string" },
    { "key": "sampleLocationId", "value": "d82998ec-7a31-5079-994c-8f4305896328", "type": "string" },
    { "key": "sampleRoomTypeId", "value": "c93d0774-fc39-5cdc-96af-633dfdc97d80", "type": "string" },
    { "key": "checkIn", "value": "2026-12-10", "type": "string" },
    { "key": "checkOut", "value": "2026-12-13", "type": "string" },
    { "key": "bookingReference", "value": "HBP-TESTREF1", "type": "string" },
    { "key": "guestEmail", "value": "traveler@example.com", "type": "string" },
    { "key": "csrfToken", "value": "", "type": "string" },
    { "key": "cancellationProof", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Send Registration OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"fullName\": \"Alex Morgan\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/send-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "send-otp"] },
            "description": "Dispatches a 6-digit OTP to the provided email address via the external OTP microservice."
          }
        },
        {
          "name": "1.2 Verify Registration OTP & Set Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.csrfToken) {",
                  "    pm.collectionVariables.set('csrfToken', json.data.csrfToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"fullName\": \"Alex Morgan\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-otp"] },
            "description": "Verifies registration OTP, creates customer record, issues JWT HttpOnly cookie, and returns CSRF token."
          }
        },
        {
          "name": "1.3 Password Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "1.4 Get Current Profile (Protected /me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "1.5 Logout & Revoke Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-csrf-token", "value": "{{csrfToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Locations",
      "item": [
        {
          "name": "2.1 List All Active Locations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/locations", "host": ["{{baseUrl}}"], "path": ["api", "locations"] }
          }
        },
        {
          "name": "2.2 Get Location by ID or City",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/locations/{{sampleLocationId}}", "host": ["{{baseUrl}}"], "path": ["api", "locations", "{{sampleLocationId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Hotels",
      "item": [
        {
          "name": "3.1 List Active Hotels (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?page=1&limit=10&sortBy=price&sortOrder=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "price" },
                { "key": "sortOrder", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "3.2 Filter Hotels by City",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=Mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "Mumbai" }]
            }
          }
        },
        {
          "name": "3.3 Get Hotel Details by Slug or UUID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/hotels/{{sampleHotelId}}", "host": ["{{baseUrl}}"], "path": ["api", "hotels", "{{sampleHotelId}}"] }
          }
        },
        {
          "name": "3.4 Hotel Not Found (404 Check)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/hotels/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["api", "hotels", "00000000-0000-0000-0000-000000000000"] }
          }
        }
      ]
    },
    {
      "name": "4. Room Types",
      "item": [
        {
          "name": "4.1 Get Room Categories for Hotel",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/hotels/{{sampleHotelId}}/rooms", "host": ["{{baseUrl}}"], "path": ["api", "hotels", "{{sampleHotelId}}", "rooms"] }
          }
        }
      ]
    },
    {
      "name": "5. Search",
      "item": [
        {
          "name": "5.1 Search Hotels (Dates & Capacity)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels/search?city=Mumbai&checkIn={{checkIn}}&checkOut={{checkOut}}&guests=2&rooms=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "search"],
              "query": [
                { "key": "city", "value": "Mumbai" },
                { "key": "checkIn", "value": "{{checkIn}}" },
                { "key": "checkOut", "value": "{{checkOut}}" },
                { "key": "guests", "value": "2" },
                { "key": "rooms", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "5.2 Search with Price and Amenity Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels/search?city=Mumbai&checkIn={{checkIn}}&checkOut={{checkOut}}&minPrice=2000&maxPrice=8000&amenities=WIFI,POOL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "search"],
              "query": [
                { "key": "city", "value": "Mumbai" },
                { "key": "checkIn", "value": "{{checkIn}}" },
                { "key": "checkOut", "value": "{{checkOut}}" },
                { "key": "minPrice", "value": "2000" },
                { "key": "maxPrice", "value": "8000" },
                { "key": "amenities", "value": "WIFI,POOL" }
              ]
            }
          }
        },
        {
          "name": "5.3 Reject Past Check-In Date (400 Check)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels/search?city=Mumbai&checkIn=2020-01-01&checkOut=2020-01-04",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "search"],
              "query": [
                { "key": "city", "value": "Mumbai" },
                { "key": "checkIn", "value": "2020-01-01" },
                { "key": "checkOut", "value": "2020-01-04" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6. Availability",
      "item": [
        {
          "name": "6.1 Room Availability & Pricing Breakdown",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/availability?roomTypeId={{sampleRoomTypeId}}&checkIn={{checkIn}}&checkOut={{checkOut}}&rooms=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "availability"],
              "query": [
                { "key": "roomTypeId", "value": "{{sampleRoomTypeId}}" },
                { "key": "checkIn", "value": "{{checkIn}}" },
                { "key": "checkOut", "value": "{{checkOut}}" },
                { "key": "rooms", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "6.2 Multi-Room Capacity Verification",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/availability?roomTypeId={{sampleRoomTypeId}}&checkIn={{checkIn}}&checkOut={{checkOut}}&rooms=3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "availability"],
              "query": [
                { "key": "roomTypeId", "value": "{{sampleRoomTypeId}}" },
                { "key": "checkIn", "value": "{{checkIn}}" },
                { "key": "checkOut", "value": "{{checkOut}}" },
                { "key": "rooms", "value": "3" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "7. Booking",
      "item": [
        {
          "name": "7.1 Create Guest Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.bookingReference) {",
                  "    pm.collectionVariables.set('bookingReference', json.data.bookingReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{sampleRoomTypeId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"rooms\": 1,\n  \"guest\": {\n    \"name\": \"Jane Doe\",\n    \"email\": \"{{guestEmail}}\",\n    \"phone\": \"+919876543210\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "7.2 Create Multi-Room Booking with Idempotency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-test-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": \"{{sampleRoomTypeId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"rooms\": 2,\n  \"guest\": {\n    \"name\": \"Multi Room Traveler\",\n    \"email\": \"multi@example.com\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "7.3 Booking Lookup by Reference & Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"{{guestEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/lookup", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "lookup"] }
          }
        },
        {
          "name": "7.4 Anti-Enumeration 404 Check (Mismatched Email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"wrong-intruder@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/lookup", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "lookup"] }
          }
        }
      ]
    },
    {
      "name": "8. Booking History",
      "item": [
        {
          "name": "8.1 Customer Booking History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/my-bookings?page=1&limit=10&status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "my-bookings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "CONFIRMED" }
              ]
            }
          }
        },
        {
          "name": "8.2 Reject customerId Tampering Attempt (400 Check)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/bookings/my-bookings?customerId=00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "my-bookings"],
              "query": [{ "key": "customerId", "value": "00000000-0000-0000-0000-000000000000" }]
            }
          }
        }
      ]
    },
    {
      "name": "9. Cancellation",
      "item": [
        {
          "name": "9.1 Request Cancellation OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"{{guestEmail}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/cancellation/send-otp", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "cancellation", "send-otp"] }
          }
        },
        {
          "name": "9.2 Verify Cancellation OTP & Get Proof",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.cancellationProof) {",
                  "    pm.collectionVariables.set('cancellationProof', json.data.cancellationProof);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"{{guestEmail}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/cancellation/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "cancellation", "verify-otp"] }
          }
        },
        {
          "name": "9.3 Confirm Cancellation (Restores Inventory)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"{{guestEmail}}\",\n  \"cancellationProof\": \"{{cancellationProof}}\",\n  \"reason\": \"Changed travel itinerary\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/cancellation/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "cancellation", "cancel"] }
          }
        },
        {
          "name": "9.4 Replay Rejection Check (400 Invalid Proof)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingReference\": \"{{bookingReference}}\",\n  \"email\": \"{{guestEmail}}\",\n  \"cancellationProof\": \"{{cancellationProof}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings/cancellation/cancel", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "cancellation", "cancel"] }
          }
        }
      ]
    }
  ]
}
